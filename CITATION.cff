# Human- and machine-readable citation for this repository.
# The doi: and date-released fields are filled at release, when the Hugging Face
# dataset and paper pages exist. Until then cite by commit.
cff-version: 1.3.0
message: >-
  Cite the paper for the method and findings, the dataset for the evidence
  bundle, and the commit for the tooling that produced a number. See
  the dataset card's Citation section for the citation rules (snapshot not branch; name
  the collection round; cite client version plus service, not the model alone).
  This is a pre-release (last revised 2026-09-11): cite the snapshot, never a branch.
title: "AI Service QoS: An Independent Outside-In Measurement Methodology, with Case Study 1 (Qwen3.8-Max / Qoder)"
authors:
  - name: "2makeitwork"
    # Pseudonymous by choice. Independent, unaffiliated author (decided 2026-09-11): no
    # affiliation is to be added here or in any listing, archive record or citation form
    # Do not attempt to resolve the handle to a person.
type: dataset
version: "0.3.0-pre"      # matches the tag v0.3.0-pre; pre-release, definitions may still move
date-released: "2026-09-11"   # last revision of the document set, not a release date
# doi: ""                 # dataset DOI, then paper-page DOI
repository-code: "https://github.com/2makeitwork/paper_ai_Qos"
repository-artifact: "https://huggingface.co/datasets/2makeitwork/paper_ai_Qos"
license: >-
  CC-BY-4.0 (text, tables, figures and evidence data; see LICENSE-content.md);
  MIT (executable tooling under scripts/; see LICENSE-code.md)
# A commit hash cannot be written into the commit it names, so the snapshot to cite is the
# tag: v0.3.0-pre. Zenodo's GitHub integration mints the version DOI from the release page.
keywords:
  - AI service quality
  - large language model service measurement
  - timeout
  - latency distribution
  - observability from client logs
  - Qwen3.8-Max
  - Qoder CN
preferred-citation:
  type: report
  title: "AI Service QoS: An Independent Outside-In Measurement Methodology, with Case Study 1 (Qwen3.8-Max / Qoder)"
  authors:
    - name: "2makeitwork"
  # year: 2026
  # doi: ""
  # url: "https://huggingface.co/papers/..."   # paper page once published
  institution: "Independent"
versions:
  - date-released: "2026-09-10"
    version: "0.2.0"
    changes: "Round 2 collection: evidence/incident_20260910/ (62 request episodes, per-request context occupancy, the compaction pair and three negative results)."
  - date-released: "2026-09-09"
    version: "0.1.0"
    changes: "Round 1 frozen: evidence/ covering 2026-09-01 to 2026-09-09 (33 timeout events, all client code 80408; 18 quota or account events; phase and task-lifecycle extracts)."
