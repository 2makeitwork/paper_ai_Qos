# systemd USER timer — drives qoder-log-mirror.service once a minute.
#
# Why a timer and not a long-running loop: the coding-agent harness reaps
# processes spawned from a tool call, and a loop service that dies quietly takes
# the capture down with it (observed 2026-09-09: the mirror stopped for eight
# hours and the only symptom was a ledger that stopped advancing). A timer makes
# every scan a separate one-shot, so the next minute always tries again, and
# Persistent=true replays a missed tick after suspend or a session gap.
#
# Install (see qoder-log-mirror.service header for the full sequence):
#   systemctl --user enable --now qoder-log-mirror.timer
#   systemctl --user list-timers qoder-log-mirror.timer
# Verified with: systemd-analyze verify ~/.config/systemd/user/qoder-log-mirror.*

[Unit]
Description=Run the Qoder CN runtime-log mirror every minute

[Timer]
OnBootSec=30s
OnUnitInactiveSec=60s
AccuracySec=5s
Persistent=true
Unit=qoder-log-mirror.service

[Install]
WantedBy=timers.target
