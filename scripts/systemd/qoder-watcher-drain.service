# One-shot: pull the Qoder CN chat watcher's queued DOM events to disk and exit.
# Run by qoder-watcher-drain.timer, NOT as a persistent process — the coding-agent
# harness reaps any process a tool call spawns, but init-spawned drains survive.
# The in-page observer (inside the Qoder CN renderer) keeps queueing timestamped
# events in window.__QOSQ between drains, so nothing is lost as long as the IDE
# window is not reloaded/relaunched.
#
# Node.js resolution (fixed 2026-09-10): this unit failed with
#   env: 'node': No such file or directory   (exit status 127)
# because systemd gives user units its own PATH, which does not contain
# version-manager installs (nvm, fnm, pnpm). `/usr/bin/bash -lc` runs the user's
# login shell, whose startup files add that directory, so the binary is found on
# any machine without hard-coding a version path. If your node is not on the
# login shell's PATH, replace the ExecStart with an absolute binary path.
#
# Install:  see scripts/systemd/README note or:
#   mkdir -p ~/.config/systemd/user && cp scripts/systemd/qoder-watcher-drain.* ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now qoder-watcher-drain.timer
#   systemctl --user start qoder-watcher-drain.service   # test one drain by hand

[Unit]
Description=Drain Qoder CN chat-timing watcher queue to disk (one-shot)

[Service]
Type=oneshot
ExecStart=/usr/bin/bash %h/Documents/source/hugging_face_qos_qwen3.8/scripts/systemd/watcher-drain.sh
Nice=10
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
