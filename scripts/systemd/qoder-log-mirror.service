# systemd USER unit — tamper-evident mirror of the Qoder CN runtime logs.
#
# This is the ONE-SHOT half of a timer pair: qoder-log-mirror.timer starts it
# every minute, it scans once and exits. Preferred over the old long-running
# `scan --interval 180` loop for two reasons: (1) a crash or a hang cannot
# silently stop the capture — the next tick simply starts a fresh scan;
# (2) a process spawned from a coding-agent tool call gets reaped with the
# session, an init-spawned one-shot does not (learned 2026-09-09, when a
# mirror started from a tool call went quiet for 8 hours without anyone
# noticing — the ledger just stops advancing).
#
# Install (run as your normal user, no sudo). The %h below expands to your home
# directory; adjust the repo path if your checkout lives elsewhere:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/qoder-log-mirror.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now qoder-log-mirror.timer
#   systemctl --user list-timers qoder-log-mirror.timer   # next + last run
#   journalctl --user -u qoder-log-mirror.service -f      # follow its log
#
# To keep it running across logout/reboot without an open session:
#   loginctl enable-linger "$USER"
#
# READ-ONLY against ~/.config/QoderCN/logs; writes only into the repo's
# logs_mirror/ tree. Stop: systemctl --user disable --now qoder-log-mirror.timer

[Unit]
Description=Qoder CN runtime-log mirror, single scan (tamper-evident integrity monitor)
After=default.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/Documents/source/hugging_face_qos_qwen3.8/scripts/log_mirror.py scan --once
Nice=10
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
# A scan that overlaps the previous one is harmless (the ledger is append-only
# and the mirror files are per-(path,inode)), but keep a hard ceiling so a stuck
# scan cannot pile up processes:
TimeoutStartSec=50

[Install]
WantedBy=default.target
